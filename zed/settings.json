// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "disable_ai": true,
  "cli_default_open_behavior": "new_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim": {
    "use_system_clipboard": "on_yank"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 16.0,
    "font_family": "PlemolJP Console NF"
  },
  "project_panel": {
    "auto_fold_dirs": false
  },
  "agent": {
    "enabled": true,
    "button": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "preview_tabs": {
    "enabled": false
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": false,
  "relative_line_numbers": "enabled",
  "sticky_scroll": {
    "enabled": false
  },
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never",
    "thumb": "always"
  },
  "scrollbar": {
    "axes": {
      "vertical": false
    }
  },
  "cursor_blink": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "MapleMono NF CN",
  "colorize_brackets": true,
  "auto_indent_on_paste": true,
  "use_on_type_format": true,
  "show_whitespaces": "all",
  "show_edit_predictions": true,
  "line_ending": "prefer_lf",
  "format_on_save": "on",
  "indent_guides": {
    "enabled": true
  },
  "soft_wrap": "none",
  "tab_size": 4,
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  // Mac/Windows で共有するため OS 固有の設定はここで上書きする
  "macos": {
    "terminal": {
      "env": {
        "FIG_NEW_SESSION": "\"1\""
      }
    }
  },
}
